# Copy to .env for local use (export the variables yourself, or use your shell). NEVER commit real values.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=use-a-strong-password-10+chars
OWNER_NAME=Owner
DATA_DIR=./data
# Optional - leave empty on Render to auto-detect the hosting URL
PUBLIC_URL=
FORCE_HTTPS=1
# Optional SMTP (enables email verification + password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
